PORT=5001
MONGO_URI=mongodb://root:example@localhost:27017/wavetalk?authSource=admin
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# MinIO (S3-compatible) object storage
# When running via Docker Compose, set MINIO_ENDPOINT=minio (service name)
# When running locally, set MINIO_ENDPOINT=localhost
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wavetalk
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
