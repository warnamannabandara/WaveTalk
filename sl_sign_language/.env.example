# ============================================================
# SLSL Translation System — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# API Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
LOG_LEVEL=info

# Model Paths (relative to sl_sign_language/)
DNN_MODEL_PATH=saved_models/dnn_model.h5
LSTM_MODEL_PATH=saved_models/lstm_model.h5
LABEL_MAP_PATH=saved_models/label_map.json

# MediaPipe Settings
MAX_NUM_HANDS=1
MIN_DETECTION_CONFIDENCE=0.7
MIN_TRACKING_CONFIDENCE=0.5

# Data Collection
DATA_DIR=data
SAMPLES_PER_LETTER=200
SEQUENCE_LENGTH=30

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
